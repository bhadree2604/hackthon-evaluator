{
  "expo": {
    "name": "Hackfinity 3.0",
    "slug": "hackfinity30",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/brand/icon-512.png",
    "scheme": "hackfinity30",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#050509",
    "primaryColor": "#57e6ff",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ramcoad.hackfinity3",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "buildNumber": "7"
    },
    "android": {
      "package": "com.ramcoad.hackfinity3",
      "adaptiveIcon": {
        "backgroundColor": "#050509",
        "foregroundImage": "./assets/images/brand/icon-512.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 7
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/brand/icon-192.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Hackfinity 3.0 uses the camera to scan the QR and barcode on a team badge.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050509",
          "image": "./assets/images/brand/icon-512.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#57e6ff",
          "defaultChannel": "hackfinity-default",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "af97ac53-c001-44b7-a319-18aaa27fb9fb"
      }
    },
    "owner": "mrdivine17"
  }
}
