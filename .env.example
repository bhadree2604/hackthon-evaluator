# Copy to .env.local. `npx convex dev` writes CONVEX_DEPLOYMENT here automatically;
# add the two EXPO_PUBLIC_ lines yourself so the mobile build can reach the backend.

CONVEX_DEPLOYMENT=dev:your-deployment-name

# From the URL `npx convex dev` prints.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Same subdomain, .site instead of .cloud. Hosts the Better Auth HTTP routes.
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
